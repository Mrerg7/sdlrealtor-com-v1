---
import '../styles/global.css';
import { SITE, OG_IMAGE, ACQUISITION_MAILTO } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, SITE.url);
const publishedDate = '2026-07-07';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}#website`,
      url: SITE.url,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}#webpage`,
      url: SITE.url,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}#website` },
      datePublished: publishedDate,
      dateModified: publishedDate,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Product',
      '@id': `${SITE.url}#product`,
      name: 'sdlrealtor.com Premium Domain Name',
      description:
        'The definitive premium domain for the most influential realtor or real estate brand in Scottsdale, Arizona. Available for acquisition.',
      url: SITE.url,
      image: OG_IMAGE,
      category: 'Premium Domain Name',
      brand: {
        '@type': 'Brand',
        name: 'sdlrealtor.com',
      },
      offers: {
        '@type': 'Offer',
        url: ACQUISITION_MAILTO,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        seller: {
          '@type': 'Organization',
          name: 'SDL Domains',
          email: SITE.email,
        },
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#organization`,
      name: 'SDL Domains',
      url: SITE.url,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Scottsdale',
        addressRegion: 'AZ',
        addressCountry: 'US',
      },
    },
    {
      '@type': 'RealEstateAgent',
      name: 'sdlrealtor.com',
      description:
        'Premium Scottsdale luxury real estate domain positioning for authoritative realtor branding.',
      areaServed: {
        '@type': 'City',
        name: 'Scottsdale',
        containedInPlace: {
          '@type': 'State',
          name: 'Arizona',
        },
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sdlrealtor.com, Scottsdale realtor domain for sale, premium real estate domain Scottsdale, luxury realtor branding Scottsdale, top Scottsdale real estate domain"
    />
    <meta name="author" content="SDL Domains" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sdlrealtor.com — Premium Domain for Scottsdale Real Estate Authority" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="sdlrealtor.com — Premium Domain for Scottsdale Real Estate Authority" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
