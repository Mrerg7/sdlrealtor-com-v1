---
import InquiryForm from './InquiryForm.astro';
import { SITE } from '../config/site';
---

<section class="bg-slate-950" id="acquire" aria-labelledby="acquire-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-start">
      <div>
        <p class="inline-flex px-3 py-1 rounded-3xl bg-white/10 text-white text-xs tracking-[1.5px] font-medium">
          SERIOUS INQUIRIES
        </p>
        <h2 id="acquire-heading" class="mt-4 text-white text-3xl sm:text-4xl md:text-5xl tracking-tighter font-semibold">
          Ready to own sdlrealtor.com?
        </h2>
        <p class="mt-4 text-slate-300 max-w-md leading-relaxed">
          One buyer gets the name. Tell us how you would use it. If your mail app is awkward on a phone,
          the form still gives you a note you can copy to {SITE.email}.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-slate-300">
          <li>Confidential. We do not publish inquiries.</li>
          <li>Typical reply within 24–48 hours.</li>
          <li>Escrow-friendly transfer. Domain only, unless we agree otherwise.</li>
        </ul>
        <p class="mt-6 text-sm">
          <a class="text-white font-semibold underline decoration-white/30 underline-offset-4 break-all" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </p>
      </div>

      <div class="rounded-3xl bg-white p-5 sm:p-7 shadow-xl">
        <h3 class="text-lg font-semibold tracking-tight text-slate-900">Make an offer</h3>
        <p class="mt-1 mb-5 text-sm text-slate-500">Price is discussed privately. A number is optional.</p>
        <InquiryForm id="inquiry" />
      </div>
    </div>
  </div>
</section>
