---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="bg-slate-950 text-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-8 pb-8 sm:pt-14 sm:pb-16">
    <p class="text-xs font-semibold tracking-[2px] uppercase text-amber-400">{eyebrow}</p>
    <h1 class="mt-3 font-display text-3xl sm:text-5xl text-white">{title}</h1>
    <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">{lede}</p>
  </div>
</header>
