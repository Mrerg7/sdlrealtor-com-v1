---
import { FOOTER_LINKS, PORTFOLIO_LINKS, SITE } from '../config/site';
---

<footer class="bg-slate-950 border-t border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid gap-10 md:grid-cols-[1.3fr_0.7fr]">
      <div>
        <p class="text-xs uppercase tracking-[2px] text-amber-400 font-semibold">Domain for sale</p>
        <p class="mt-3 font-display text-3xl text-white">sdlrealtor.com</p>
        <p class="mt-3 text-sm text-slate-400 max-w-md leading-relaxed">
          Offered by {SITE.owner}, {SITE.location}. This is a domain sale, not a brokerage and not a listing service.
        </p>
        <a href="/acquire/#inquiry" class="mt-6 inline-flex items-center justify-center h-12 px-6 rounded-2xl bg-white text-slate-900 font-semibold">
          Make an Offer
        </a>
      </div>
      <nav aria-label="Footer">
        <ul class="space-y-2 text-sm">
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-slate-300 hover:text-white">{link.label}</a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${SITE.email}`} class="text-slate-300 hover:text-white break-all">{SITE.email}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10">
      <p class="text-xs uppercase tracking-[1.5px] text-slate-500 font-semibold">SDL portfolio</p>
      <ul class="mt-3 flex flex-col sm:flex-row sm:flex-wrap gap-y-2 sm:gap-x-5 text-sm">
        {
          PORTFOLIO_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-amber-400 hover:text-amber-300" rel="noopener noreferrer">{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-10 text-xs text-slate-500 leading-relaxed max-w-4xl">
      sdlrealtor.com is for sale. Buying the domain does not include a real estate license, leads, a website, or trademark rights.
      REALTOR® is a registered trademark of the National Association of REALTORS®. SDL Domains is not affiliated with NAR.
      Market figures on this site are published ranges as of mid-2026, not appraisals. The domain does not guarantee search rankings.
      Figures current as of {SITE.disclaimerDate}.
    </p>

    <div class="pt-8 mt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row gap-y-2 sm:justify-between">
      <p>&copy; 2026 {SITE.owner}. Scottsdale, Arizona.</p>
      <p>Premium real estate domains · Serious buyers only</p>
    </div>
  </div>
</footer>
