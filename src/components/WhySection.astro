---
import { getCollection } from 'astro:content';

const whyCards = (await getCollection('why')).sort((a, b) => a.data.order - b.data.order);
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 pb-12" id="why">
  <div class="max-w-2xl">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">THE OPPORTUNITY</div>
    <h2 class="section-heading font-display">
      Own the most authoritative domain in Scottsdale real estate.
    </h2>
    <p class="mt-5 text-lg text-slate-600">
      sdlrealtor.com is short, powerful, and instantly communicates expertise and authority in Scottsdale
      real estate. It positions the owner as the go-to professional in Arizona's most exclusive and
      influential luxury market — perfect for a top-producing realtor, boutique brokerage, or premium real
      estate brand.
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-3 gap-5">
    {
      whyCards.map(({ data }) => (
        <div class="value-card bg-white border border-slate-200 rounded-3xl p-7">
          <div class="text-amber-brand text-xs tracking-widest font-semibold mb-3">{data.label}</div>
          <div class="font-semibold text-xl tracking-tight">{data.title}</div>
          <p class="mt-3 text-sm text-slate-600">{data.description}</p>
        </div>
      ))
    }
  </div>
</section>
