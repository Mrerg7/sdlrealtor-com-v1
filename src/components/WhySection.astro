---
import { getCollection } from 'astro:content';

const whyCards = (await getCollection('why')).sort((a, b) => a.data.order - b.data.order);
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 pb-12" id="why">
  <div class="max-w-2xl">
    <p class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">The opportunity</p>
    <h2 class="section-heading font-display">
      Own the clearest Scottsdale realtor name on a .com.
    </h2>
    <p class="mt-5 text-lg text-slate-600 leading-relaxed">
      sdlrealtor.com is short enough to say out loud and specific enough that a stranger knows the market.
      SDL is how Scottsdale already abbreviates itself — it is the
      <a href="https://www.scottsdaleaz.gov/scottsdale-airport" class="font-medium text-slate-900 underline decoration-slate-300 underline-offset-4" rel="noopener noreferrer">Scottsdale Airport</a>
      code — and “realtor” is the word clients type. Together they are an eleven-letter brand, not a sentence.
    </p>
  </div>

  <div class="mt-10 grid md:grid-cols-3 gap-5">
    {
      whyCards.map(({ data }) => (
        <article class="value-card bg-white border border-slate-200 rounded-3xl p-6 sm:p-7">
          <p class="text-amber-brand text-xs tracking-widest font-semibold mb-3">{data.label}</p>
          <h3 class="font-semibold text-xl tracking-tight">{data.title}</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">{data.description}</p>
        </article>
      ))
    }
  </div>
</section>
