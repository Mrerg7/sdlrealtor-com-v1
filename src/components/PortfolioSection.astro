---
import { PORTFOLIO_LINKS } from '../config/site';
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 text-center">
  <div class="max-w-lg mx-auto">
    <p class="text-sm text-slate-500">Part of the SDL family of premium Scottsdale & Phoenix-focused domains</p>
    <div class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
      {
        PORTFOLIO_LINKS.map((link, index) => (
          <>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-amber-brand hover:text-amber-700"
            >
              {link.label}
            </a>
            {index < PORTFOLIO_LINKS.length - 1 && (
              <span class="text-slate-300 hidden md:inline" aria-hidden="true">•</span>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>
