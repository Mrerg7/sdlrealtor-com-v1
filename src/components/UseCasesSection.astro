---
import { getCollection } from 'astro:content';

const useCases = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order);
---

<section class="bg-white border-y border-slate-100 py-12 sm:py-16" id="perfect-for">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="max-w-xl mb-8 sm:mb-10">
      <p class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">Ideal buyers</p>
      <h2 class="text-3xl sm:text-4xl tracking-tighter font-semibold">
        Built for someone who already works Scottsdale luxury.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        useCases.map((entry) => (
          <a
            href={`/acquire/?use=${entry.id}#inquiry`}
            class="group block border border-slate-200 hover:border-amber-300 rounded-3xl p-6 sm:p-7 bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-brand"
          >
            <div class="text-3xl mb-4" aria-hidden="true">{entry.data.icon}</div>
            <h3 class="font-semibold text-xl tracking-tight">{entry.data.title}</h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{entry.data.description}</p>
            <p class="mt-5 text-sm font-semibold text-amber-brand group-hover:underline">
              Inquire for this use
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
