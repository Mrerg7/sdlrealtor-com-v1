---
import { getCollection } from 'astro:content';

const marketStats = (await getCollection('market')).sort((a, b) => a.data.order - b.data.order);
---

<section class="max-w-5xl mx-auto px-6 py-16" id="market">
  <div class="max-w-2xl mb-10">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">THE MARKET</div>
    <h2 class="text-4xl tracking-tighter font-semibold">
      Scottsdale is Arizona's rarest and most influential luxury real estate market.
    </h2>
    <p class="mt-4 text-slate-600">
      Known for its exclusive neighborhoods, world-class golf communities, stunning desert architecture,
      and affluent clientele, Scottsdale consistently attracts high-net-worth buyers seeking privacy,
      lifestyle, and long-term value in one of the Southwest's most desirable locations.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      marketStats.map(({ data }) => (
        <div class="market-stat bg-white border border-slate-200 rounded-3xl p-7">
          <div class="text-amber-brand text-xs tracking-widest font-semibold mb-2">{data.label}</div>
          <div class="font-semibold text-lg">{data.title}</div>
          {data.stats ? (
            <div class="mt-4 space-y-3 text-sm">
              {data.stats.map((stat) => (
                <div class="flex justify-between gap-4">
                  <span>{stat.label}</span>
                  <span class="font-semibold text-right">{stat.value}</span>
                </div>
              ))}
            </div>
          ) : (
            <p class="mt-3 text-sm text-slate-600">{data.description}</p>
          )}
        </div>
      ))
    }
  </div>

  <p class="mt-8 text-xs text-slate-500 max-w-3xl">
    Market data drawn from recent Scottsdale real estate reports and U.S. Census/economic indicators
    (2025–2026). Scottsdale remains one of Arizona's strongest and most prestigious real estate markets.
  </p>
</section>
