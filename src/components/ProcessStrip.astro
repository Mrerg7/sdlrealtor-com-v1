---
import { PROCESS_STEPS } from '../config/site';
---

<section class="bg-white border-y border-slate-100" id="process" aria-labelledby="process-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="max-w-2xl">
      <p class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">How to buy</p>
      <h2 id="process-heading" class="text-3xl sm:text-4xl tracking-tighter font-semibold">
        A straightforward domain acquisition.
      </h2>
      <p class="mt-4 text-slate-600">
        Four steps, one name, no brokerage pitch. Read the full transfer notes on the
        <a href="/acquire/" class="font-semibold text-slate-900 underline decoration-amber-brand/60 underline-offset-4">acquire sdlrealtor.com</a>
        page.
      </p>
    </div>
    <ol class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        PROCESS_STEPS.map((item) => (
          <li class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-semibold tracking-[1.5px] text-amber-brand">{item.step}</p>
            <h3 class="mt-2 text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
