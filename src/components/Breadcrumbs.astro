---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-white border-b border-slate-200">
  <ol class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
    <li>
      <a href="/" class="hover:text-slate-900 font-medium">Home</a>
    </li>
    {
      crumbs.map((crumb) => (
        <li class="flex items-center gap-x-2 min-w-0">
          <span aria-hidden="true">/</span>
          <a href={crumb.href} class="hover:text-slate-900 font-medium text-slate-800 truncate" aria-current="page">
            {crumb.name}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
