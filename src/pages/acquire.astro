---
import SiteFrame from '../components/SiteFrame.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { PROCESS_STEPS, SITE } from '../config/site';

const title = 'Acquire sdlrealtor.com | Make an Offer';
const description =
  'Buy sdlrealtor.com through a private offer and escrow transfer. Domain name only. Contact SDL Domains at sales@desertrich.com. Reply in 24–48 hours.';
---

<SiteFrame
  title={title}
  description={description}
  crumbs={[{ name: 'Acquire', href: '/acquire/' }]}
>
  <PageHero
    eyebrow="Domain for sale"
    title="Acquire sdlrealtor.com"
    lede="The name is available. Send a confidential offer or ask for next steps. If we agree on price, payment goes through escrow — not a direct wire."
  />

  <section class="bg-white border-b border-slate-200" aria-labelledby="offer-heading">
    <div class="max-w-xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
      <h2 id="offer-heading" class="text-3xl font-semibold tracking-tight text-slate-900">Send your inquiry</h2>
      <p class="mt-3 text-slate-600 text-sm leading-relaxed">
        Opens a draft to {SITE.email}. Nothing is stored on this site. Transfer questions are on the
        <a href="/faq/" class="font-semibold text-slate-900 underline decoration-amber-brand/50 underline-offset-4">buyer FAQ</a>.
      </p>
      <div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5 sm:p-7">
        <InquiryForm id="inquiry" />
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl font-semibold tracking-tight">What happens next</h2>
    <ol class="mt-6 grid sm:grid-cols-2 gap-4">
      {
        PROCESS_STEPS.map((item) => (
          <li class="rounded-3xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold tracking-[1.5px] text-amber-brand">{item.step}</p>
            <h3 class="mt-2 text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 grid md:grid-cols-2 gap-4">
      <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold">Included</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-600 list-disc pl-5">
          <li>The domain name sdlrealtor.com</li>
          <li>Registrar auth code or an account push after escrow</li>
          <li>Coordination with your broker or attorney if you want one</li>
        </ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold">Not included</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-600 list-disc pl-5">
          <li>A real estate license, brokerage, or leads</li>
          <li>Website, content, or social accounts</li>
          <li>Rights to the REALTOR® trademark</li>
          <li>Any promise of search rankings</li>
        </ul>
      </div>
    </div>
  </section>
</SiteFrame>
