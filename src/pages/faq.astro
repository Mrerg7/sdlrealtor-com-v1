---
import SiteFrame from '../components/SiteFrame.astro';
import PageHero from '../components/PageHero.astro';
import { FAQS } from '../config/faq';
import { SITE } from '../config/site';

const title = 'sdlrealtor.com Buyer FAQ | Domain for Sale';
const description =
  'Answers for buyers of sdlrealtor.com: price, escrow, what SDL means, what is included, and why the domain does not guarantee rankings.';

const faqGraph = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}faq/#faq`,
  url: `${SITE.url}faq/`,
  mainEntity: FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<SiteFrame
  title={title}
  description={description}
  crumbs={[{ name: 'FAQ', href: '/faq/' }]}
  extraGraph={[faqGraph]}
>
  <PageHero
    eyebrow="Buyer questions"
    title="Before you make an offer"
    lede="Straight answers about what is for sale, how transfer works, and what the name will not do for you."
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="space-y-8">
      {
        FAQS.map((item) => (
          <article class="border-b border-slate-200 pb-8">
            <h2 class="text-xl font-semibold tracking-tight text-slate-900">{item.question}</h2>
            <p class="mt-3 text-slate-600 leading-relaxed">{item.answer}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-10">
      <a href="/acquire/#inquiry" class="inline-flex items-center justify-center h-12 px-6 rounded-2xl bg-slate-900 text-white font-semibold">
        Make an Offer
      </a>
    </p>
  </section>
</SiteFrame>
