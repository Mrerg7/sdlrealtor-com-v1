---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | sdlrealtor.com" description="That page is not on sdlrealtor.com." noindex>
  <div class="min-h-screen flex flex-col items-center justify-center px-6 py-16 bg-slate-50 text-center">
    <p class="text-6xl font-bold tracking-tighter text-slate-900">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Page not found</h1>
    <p class="mt-2 text-slate-600 max-w-md">
      The domain is still for sale. Go back to the offer page or return home.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center w-full sm:w-auto">
      <a href="/" class="inline-flex items-center justify-center h-12 px-6 bg-slate-900 text-white font-semibold rounded-2xl">
        Back to Home
      </a>
      <a href="/acquire/" class="inline-flex items-center justify-center h-12 px-6 border border-slate-300 font-semibold rounded-2xl">
        Acquire the domain
      </a>
    </div>
  </div>
</BaseLayout>
